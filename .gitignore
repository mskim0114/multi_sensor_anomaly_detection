# ============================================================================
# Project-specific rules.
#
# RESTORED 2026-08-31. Commit 5a0e117 replaced .gitignore with a generic Python
# template that dropped every rule below, which left ~26 GB of datasets, model
# artifacts and transfer tarballs untracked-but-not-ignored. A single `git add -A`
# would have staged all of it. Do not remove this section.
# ============================================================================

# Local datasets and generated results (large, never committed)
/data/
/cache/
/results/
/logs/

# Deployment/generated outputs
jetson_deploy/results/
jetson_deploy/reference/*.npz
jetson_deploy/model/*.onnx
jetson_deploy/model/*.trt
jetson_deploy/model/*.engine

# Archives and large transfer bundles
*.tar
*.tar.gz
*.tgz
*.zip

# Virtual environments are NEVER committed and NEVER live inside the repository.
# See docs/ENVIRONMENT_POLICY.md - they belong in $HOME/venvs/.
.venv/
venv/
env/
ENV/

# Editor backups
*~

# Official raw dataset - never committed
/dataset/
